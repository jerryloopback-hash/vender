{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "dns-cn",
        "type": "udp",
        "server": "223.5.5.5"
      },
      {
        "tag": "dns-fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      },
      {
        "tag": "dns-system",
        "type": "local"
      },
      {
        "tag": "profile-dns-1",
        "type": "tcp",
        "server": "dns.provider.example",
        "server_port": 8080,
        "domain_resolver": {
          "server": "dns-system"
        }
      }
    ],
    "rules": [
      {
        "action": "route",
        "domain_suffix": [
          "opencode.ai"
        ],
        "server": "dns-cn"
      },
      {
        "action": "reject",
        "rule_set": [
          "geosite-category-ads-all"
        ]
      },
      {
        "action": "route",
        "domain": [
          "bing.com",
          "www.bing.com",
          "cn.bing.com",
          "global.bing.com",
          "bing.com.cn",
          "www.bing.com.cn",
          "s.bing.net"
        ],
        "domain_suffix": [
          "r.bing.com",
          "th.bing.com",
          "cn.bing.net",
          "mm.bing.net"
        ],
        "server": "dns-cn"
      },
      {
        "action": "route",
        "rule_set": [
          "geosite-steam",
          "geosite-onedrive",
          "geosite-microsoft",
          "geosite-google",
          "geosite-youtube",
          "geosite-telegram",
          "geosite-netflix",
          "geosite-openai",
          "geosite-bahamut"
        ],
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "dns-fakeip"
      },
      {
        "action": "route",
        "rule_set": [
          "geosite-cn"
        ],
        "server": "dns-cn"
      },
      {
        "action": "route",
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "dns-fakeip"
      }
    ],
    "final": "dns-cn",
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 7897
    }
  ],
  "outbounds": [
    {
      "type": "shadowsocks",
      "tag": "Prov-SS",
      "server": "1.k.o.5.hk01-ae5.entry.v51124-6.qpon",
      "server_port": 19276,
      "method": "aes-256-gcm",
      "password": "provider-password",
      "domain_resolver": {
        "server": "profile-dns-1"
      }
    },
    {
      "type": "vmess",
      "tag": "Prov-VM",
      "server": "1kw2i0k.g06.jp02.entry.example.net",
      "server_port": 443,
      "uuid": "11111111-1111-1111-1111-111111111111",
      "security": "auto"
    },
    {
      "type": "urltest",
      "tag": "proxy",
      "outbounds": [
        "Prov-SS",
        "Prov-VM"
      ],
      "url": "http://www.gstatic.com/generate_204",
      "interval": "30s",
      "tolerance": 100
    },
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "block",
      "tag": "block"
    }
  ],
  "route": {
    "rule_set": [
      {
        "type": "local",
        "tag": "geosite-cn",
        "format": "binary",
        "path": "/run/vender/rules/geosite-cn.srs"
      },
      {
        "type": "local",
        "tag": "geosite-category-ads-all",
        "format": "binary",
        "path": "/run/vender/rules/geosite-category-ads-all.srs"
      },
      {
        "type": "local",
        "tag": "geoip-cn",
        "format": "binary",
        "path": "/run/vender/rules/geoip-cn.srs"
      },
      {
        "type": "local",
        "tag": "geosite-steam",
        "format": "binary",
        "path": "/run/vender/rules/geosite-steam.srs"
      },
      {
        "type": "local",
        "tag": "geosite-onedrive",
        "format": "binary",
        "path": "/run/vender/rules/geosite-onedrive.srs"
      },
      {
        "type": "local",
        "tag": "geosite-microsoft",
        "format": "binary",
        "path": "/run/vender/rules/geosite-microsoft.srs"
      },
      {
        "type": "local",
        "tag": "geosite-google",
        "format": "binary",
        "path": "/run/vender/rules/geosite-google.srs"
      },
      {
        "type": "local",
        "tag": "geosite-youtube",
        "format": "binary",
        "path": "/run/vender/rules/geosite-youtube.srs"
      },
      {
        "type": "local",
        "tag": "geosite-telegram",
        "format": "binary",
        "path": "/run/vender/rules/geosite-telegram.srs"
      },
      {
        "type": "local",
        "tag": "geosite-netflix",
        "format": "binary",
        "path": "/run/vender/rules/geosite-netflix.srs"
      },
      {
        "type": "local",
        "tag": "geosite-openai",
        "format": "binary",
        "path": "/run/vender/rules/geosite-openai.srs"
      },
      {
        "type": "local",
        "tag": "geosite-bahamut",
        "format": "binary",
        "path": "/run/vender/rules/geosite-bahamut.srs"
      }
    ],
    "default_domain_resolver": {
      "server": "dns-cn"
    },
    "rules": [
      {
        "action": "sniff"
      },
      {
        "action": "hijack-dns",
        "protocol": [
          "dns"
        ]
      },
      {
        "domain_suffix": [
          "opencode.ai"
        ],
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite-category-ads-all"
        ],
        "outbound": "block"
      },
      {
        "domain": [
          "bing.com",
          "www.bing.com",
          "cn.bing.com",
          "global.bing.com",
          "bing.com.cn",
          "www.bing.com.cn",
          "s.bing.net"
        ],
        "domain_suffix": [
          "r.bing.com",
          "th.bing.com",
          "cn.bing.net",
          "mm.bing.net"
        ],
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite-steam",
          "geosite-onedrive",
          "geosite-microsoft",
          "geosite-google",
          "geosite-youtube",
          "geosite-telegram",
          "geosite-netflix",
          "geosite-openai",
          "geosite-bahamut"
        ],
        "outbound": "proxy"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geoip-cn"
        ],
        "outbound": "direct"
      }
    ],
    "final": "proxy"
  }
}
