# Build output
/vender
/vender.exe
/bin/
/dist/
*.exe
*.test
*.out

# Go workspace / tooling
go.work
go.work.sum
.idea/
.vscode/
*.swp

# Local runtime state (never committed)
# The real config lives outside the repo under os.UserConfigDir(), e.g.
# ~/.config/vender/ on Linux. These patterns only catch copies made inside
# the working tree during manual testing.
/vender-data/
/local/
*.local.yaml
config.local.yaml
servers.local.yaml

# Secrets must never be committed. servers.yaml holds credentials.
servers.yaml

# A killed scripts/fetch-rules.sh could leave a partial download behind; the
# script cleans up after itself, this is a belt-and-braces guard so a partial
# .srs can never be committed or embedded.
internal/rules/assets/*.tmp.*

# Local debug handoff doc (contains real credentials) — never commit
/DEBUG-HANDOFF.md
